# gcloud falls back to .gitignore when this file is absent, which would strip
# .qdrant/ and .artifacts/ from the build context - exactly the prebuilt index
# the Dockerfile wants to ship. They are gitignored (regenerable, 124MB) but
# they do belong in the image.
.git/
.gitignore
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.env

# Dev-only: the full 60k corpus is not what the deployed image indexes.
data/corpus.jsonl
data/queries.jsonl

.DS_Store

# Only needed when sparse fusion is enabled (sparse_weight > 0); 90MB otherwise,
# and it slows the image pull on cold start. Regenerate with index/build_index.py.
.artifacts/chunks.jsonl

# Search is served from .artifacts/dense (numpy). Qdrant is the build-time store
# of record; at 200k points it is ~1GB of image for a read path nothing takes.
.qdrant/

data/corpus.deploy.jsonl
