# Both are optional. With neither set the system still answers: retrieval and the
# extractive path need no network, and the provider chain terminates in extractive
# fallback rather than an error.

# Speech-to-text. Required for POST /ask-voice; POST /ask works without it.
SARVAM_API_KEY=

# Generative answering. Without it the pipeline serves extractive answers only.
GROQ_API_KEY=
