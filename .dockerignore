.venv/
.git/
__pycache__/
*.py[cod]
.pytest_cache/
.env

# .qdrant/ and .artifacts/ are deliberately NOT excluded: the Dockerfile ships
# the prebuilt index rather than spending ~19 minutes regenerating it on a cloud
# builder. It falls back to building from the corpus when they are absent.

# Dev-only: the full 60k corpus is not what the deployed image indexes.
data/corpus.jsonl
data/queries.jsonl

.DS_Store

# Only needed when sparse fusion is enabled (sparse_weight > 0); 90MB otherwise,
# and it slows the image pull on cold start. Regenerate with index/build_index.py.
.artifacts/chunks.jsonl
